{
  "name": "trimctx",
  "version": "0.3.0",
  "description": "Local CLI for auditing AI conversation health, reviewing context risks, and writing safe trimmed copies. Supports Claude Code, OpenAI, and Codex JSONL.",
  "type": "module",
  "license": "MIT",
  "author": "trimctx contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SnowBeatRain/trimContext.git"
  },
  "homepage": "https://github.com/SnowBeatRain/trimContext#readme",
  "bugs": {
    "url": "https://github.com/SnowBeatRain/trimContext/issues"
  },
  "keywords": [
    "claude-code",
    "openai",
    "context",
    "context-rot",
    "token-optimization",
    "cli",
    "conversation",
    "jsonl",
    "codex",
    "hermes-agent"
  ],
  "bin": {
    "trimctx": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "install.sh",
    "install.ps1",
    "plugins/trimctx/",
    "codex/skills/trimctx/",
    "docs/user/usage.md",
    "docs/user/usage_zh.md",
    "docs/dev/roadmap.md",
    "docs/dev/requirements.md",
    "README.md",
    "README_zh.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:publish": "npm run build:types && esbuild src/cli.ts --bundle --platform=node --target=node20 --format=esm --packages=external --minify --legal-comments=none --outfile=dist/cli.js && node scripts/fix-publish-bundle.mjs",
    "build:types": "tsc -p tsconfig.json",
    "test": "vitest run --testTimeout=30000",
    "dev": "tsx src/cli.ts",
    "prepack": "npm run build:publish",
    "prepublishOnly": "npm test && npm run build:publish",
    "phase0:run": "tsx scripts/phase0-run.ts",
    "phase0:review": "tsx scripts/phase0-review.ts"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.11",
    "esbuild": "^0.28.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "js-tiktoken": "^1.0.20"
  },
  "peerDependenciesMeta": {
    "js-tiktoken": {
      "optional": true
    }
  }
}
