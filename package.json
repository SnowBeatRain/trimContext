{
  "name": "trimctx",
  "version": "0.2.1",
  "description": "Local CLI for analyzing and safely trimming long AI conversation context. Supports Claude Code, OpenAI, and Codex JSONL formats.",
  "type": "module",
  "license": "MIT",
  "author": "trimctx contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SnowBeatRain/trimContext.git"
  },
  "homepage": "https://github.com/SnowBeatRain/trimContext#readme",
  "bugs": {
    "url": "https://github.com/SnowBeatRain/trimContext/issues"
  },
  "keywords": [
    "claude-code",
    "openai",
    "context",
    "context-rot",
    "token-optimization",
    "cli",
    "conversation",
    "jsonl",
    "codex",
    "hermes-agent"
  ],
  "bin": {
    "trimctx": "dist/cli.js"
  },
  "files": [
    "dist/",
    "install.sh",
    "install.ps1",
    "plugins/trimctx/",
    "codex/skills/trimctx/",
    "docs/user/usage.md",
    "docs/user/usage_zh.md",
    "docs/dev/roadmap.md",
    "docs/dev/iteration-plan.md",
    "docs/dev/manual-review-rubric.md",
    "docs/dev/phase0/phase0-plan.md",
    "docs/dev/phase0/manual-label-guide.md",
    "docs/dev/phase0/validation-summary-template.md",
    "README.md",
    "README_zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/dev/requirements.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "phase0:run": "tsx scripts/phase0-run.ts"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.11",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
